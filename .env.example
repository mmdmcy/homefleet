# Copy to .env (or ~/.config/homefleet/config.env) and keep private.
# Homefleet also accepts Masterdale DALE_* names so an existing shared
# token can be reused without retyping.

# Shared bearer token for trusted peers on your private LAN.
HOMEFLEET_TOKEN=

# Or reuse a Masterdale token (same value on every device):
# DALE_TOKEN=

# Set to 1 to allow remote command execution on this device.
HOMEFLEET_EXEC=0
# DALE_REMOTE_EXEC=0

# Client source-IP scope:
# private  = loopback + private LAN + Tailscale ranges (default)
# loopback = this machine only
# tailnet  = loopback + Tailscale ranges only
# public   = any source IP (only behind a firewall / reverse proxy)
HOMEFLEET_SCOPE=private
# DALE_REMOTE_SCOPE=private

# Optional stable device id shown in peer discovery (defaults to hostname).
# HOMEFLEET_DEVICE_ID=laptop

# Optional extra CIDR allowlist (comma-separated), applied on top of scope.
# HOMEFLEET_ALLOW_CIDRS=192.168.1.0/24

# Optional path to an env file (overrides automatic discovery).
# HOMEFLEET_ENV=/path/to/.env
